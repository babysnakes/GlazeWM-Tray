<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FSharpReactiveUI.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="FSharpReactiveUI.Views.QueryPanelView"
             x:DataType="vm:QueryPanelViewModel">

    <DockPanel>
        <!-- Query input at bottom -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,8,0,0">
            <TextBox MinWidth="340"
                     Text="{Binding QueryInput}"
                     Watermark="Enter query..."/>
            <Button Content="Query"
                    Margin="4,0,0,0"
                    Command="{Binding ExecuteQueryCommand}"/>
        </StackPanel>

        <!-- Response display -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto">
            <Panel>
                <TextBlock Text="Please enter a query."
                           IsVisible="{Binding IsEmpty}"/>

                <TextBlock Text="Waiting for response..."
                           IsVisible="{Binding IsQuerying}"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           IsVisible="{Binding IsError}"/>

                <TreeView ItemsSource="{Binding TreeItems}"
                          IsVisible="{Binding IsData}">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate x:DataType="vm:JsonTreeNode"
                                          ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding DisplayText}"/>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Panel>
        </ScrollViewer>
    </DockPanel>
</UserControl>

<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:huskui="using:Huskui.Avalonia"
             x:Class="GlazeWM.TrayAppCS.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme />
        <huskui:HuskuiTheme />
        <Styles>
            <Styles.Resources>
                <ResourceDictionary>
                    <x:Double x:Key="ScrollBarThickness">12</x:Double>
                    <ResourceDictionary.ThemeDictionaries>
                        <!-- Fix invisible scrollbar thumb in Huskui dark theme -->
                        <ResourceDictionary x:Key="Dark">
                            <Color x:Key="SmokeColor">#99FFFFFF</Color>
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </Styles.Resources>
        </Styles>
    </Application.Styles>

</Application>